{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Aktiv – mit der Zendure-Cloud verbinden"
        },
        {
            "type": "Label",
            "caption": "Zendure erlaubt pro Konto nur eine Verbindung. Nutzt ein anderes System denselben Cloud-Key, hier ausschalten: Die MQTT-Verbindung wird getrennt und nichts mehr abgerufen. Umschalten geht auch über die Variable „Verbindung zur Zendure-Cloud“ oder ZENDC_SetActive."
        },
        {
            "type": "Label",
            "caption": "Cloud-Key aus der Zendure-App (Token für die Home-Assistant-Integration) hier einfügen."
        },
        {
            "type": "PasswordTextBox",
            "name": "AppToken",
            "caption": "Cloud-Key",
            "width": "600px"
        },
        {
            "type": "CheckBox",
            "name": "AutoConfigureParent",
            "caption": "Zugangsdaten automatisch in den MQTT-Client eintragen"
        },
        {
            "type": "NumberSpinner",
            "name": "RefreshHours",
            "caption": "Geräteliste/Zugangsdaten neu abrufen alle",
            "suffix": "Stunden",
            "minimum": 1,
            "maximum": 168
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Geräte und Zugangsdaten abrufen",
            "onClick": "echo ZENDC_RefreshDevices($id) ? 'Erfolgreich abgerufen.' : 'Abruf fehlgeschlagen – siehe Meldungen/Debug.';"
        },
        {
            "type": "Button",
            "caption": "MQTT-Verbindung einrichten",
            "onClick": "echo ZENDC_SetupMqttConnection($id);"
        },
        {
            "type": "Button",
            "caption": "Zugangsdaten anzeigen",
            "onClick": "echo ZENDC_GetConnectionInfo($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Verbunden mit der Zendure-Cloud"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Ausgeschaltet oder kein Cloud-Key eingetragen"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Cloud-Key ungültig oder von Zendure abgelehnt"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Zendure-Cloud nicht erreichbar"
        }
    ]
}