{
    "elements": [
        {
            "type": "Select",
            "name": "Model",
            "caption": "Modell",
            "options": [
                {
                    "caption": "SolarFlow Hub 2000",
                    "value": "Hub 2000"
                },
                {
                    "caption": "SolarFlow Hub 1200",
                    "value": "Hub 1200"
                }
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "ProductKey",
            "caption": "Product Key (leer = Standard des Modells)"
        },
        {
            "type": "ValidationTextBox",
            "name": "DeviceKey",
            "caption": "Device Key"
        },
        {
            "type": "ValidationTextBox",
            "name": "SerialNumber",
            "caption": "Seriennummer (nur Info)"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Alle Werte abfragen alle",
            "suffix": "Sekunden",
            "minimum": 10,
            "maximum": 3600
        },
        {
            "type": "NumberSpinner",
            "name": "MaxOutputPower",
            "caption": "Maximale Ausgangsleistung",
            "suffix": "W",
            "minimum": 100,
            "maximum": 2400
        },
        {
            "type": "CheckBox",
            "name": "ShowPacks",
            "caption": "Werte der einzelnen Akkus anlegen"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Hoymiles-Wechselrichter – für die Kachel",
            "items": [
                {
                    "type": "Label",
                    "caption": "Optional: Variablen aus dem Modul „Hoymiles Cloud“ des Wechselrichters, an dem der Hub hängt."
                },
                {
                    "type": "SelectVariable",
                    "name": "InverterPowerVariable",
                    "caption": "AC-Leistung des Wechselrichters"
                },
                {
                    "type": "SelectVariable",
                    "name": "DirectPVVariable",
                    "caption": "Direkt angeschlossener Eingang 1 (z. B. PV 1)"
                },
                {
                    "type": "SelectVariable",
                    "name": "DirectPVVariable2",
                    "caption": "Direkt angeschlossener Eingang 2 (z. B. PV 3)"
                },
                {
                    "type": "SelectVariable",
                    "name": "InverterEnergyTodayVariable",
                    "caption": "Ertrag heute der Anlage (z. B. „Ertrag heute“)"
                },
                {
                    "type": "Label",
                    "caption": "Ohne Eingangs-Variablen wird die direkte Solarleistung aus AC-Leistung und Hub-Ausgang geschätzt. Werte in kW werden automatisch umgerechnet."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kachel",
            "items": [
                {
                    "type": "Select",
                    "name": "TileTheme",
                    "caption": "Farbschema der Kachel",
                    "options": [
                        {
                            "caption": "Symcon-Design (Farben der Visualisierung)",
                            "value": 0
                        },
                        {
                            "caption": "Dunkel",
                            "value": 1
                        },
                        {
                            "caption": "Hell",
                            "value": 2
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "TileBackground",
                    "caption": "Hintergrund",
                    "options": [
                        {
                            "caption": "Aurora (modern, reagiert auf den Energiefluss)",
                            "value": "aurora"
                        },
                        {
                            "caption": "Szene (Haus, Tag und Nacht)",
                            "value": "scene"
                        },
                        {
                            "caption": "Eigenes Bild (ganze Kachel, abgeblendet)",
                            "value": "image"
                        },
                        {
                            "caption": "Keiner",
                            "value": "none"
                        }
                    ]
                },
                {
                    "type": "SelectMedia",
                    "name": "TileImage",
                    "caption": "Eigenes Bild (Medienobjekt)",
                    "width": "400px"
                },
                {
                    "type": "NumberSpinner",
                    "name": "TileImageOpacity",
                    "caption": "Sichtbarkeit des eigenen Bildes",
                    "suffix": "%",
                    "minimum": 5,
                    "maximum": 100
                },
                {
                    "type": "Label",
                    "caption": "Das Bild im Objektbaum als Medienobjekt (Bild) hochladen und hier auswählen. Große Bilder werden automatisch verkleinert. Empfohlen sind 20–40 % Sichtbarkeit, z. B. ein Foto des Hauses oder der Solaranlage."
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Alle Werte jetzt abfragen",
            "onClick": "ZEND_RequestUpdate($id);"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "TestPower",
                    "caption": "Ausgangsleistung",
                    "suffix": "W",
                    "minimum": 0,
                    "maximum": 2400
                },
                {
                    "type": "Button",
                    "caption": "Als Limit setzen",
                    "onClick": "echo ZEND_SetOutputLimit($id, $TestPower) ? 'Gesendet.' : 'Senden fehlgeschlagen.';"
                },
                {
                    "type": "Button",
                    "caption": "Als Entladeleistung vorgeben",
                    "onClick": "echo ZEND_SetDischargePower($id, $TestPower) ? 'Gesendet.' : 'Senden fehlgeschlagen.';"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Bereit"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Bitte Device Key (und ggf. Product Key) eintragen"
        }
    ]
}